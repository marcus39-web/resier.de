# App
APP_ENV=development
APP_URL=http://localhost:8000

# Mail (SMTP-Versand fuer Kontaktformular inkl. Auto-Bestaetigung)
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USERNAME=DEIN_MAILERSEND_SMTP_LOGIN
SMTP_PASSWORD=DEIN_MAILERSEND_SMTP_PASSWORT
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=kontakt@deinedomain.de
MAIL_FROM_NAME=Marcus Reiser Karriereprofil
MAIL_TO=deine-zieladresse@example.com

# Aufbewahrungsfrist fuer Kontaktanfragen im lokalen Log (in Tagen)
CONTACT_RETENTION_DAYS=170
